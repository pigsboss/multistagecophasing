"""与源实现直接对拍：岛内 工具/ceres_transfer.py、s4_target_scan.py、s4_polar_illum.py vs MCPC 落位件。"""
import sys, importlib
ISLAND = "/mnt/data/huo/Documents/Kimi/Workspaces/行星探测工程/专题工作区/谷神星探测"
sys.path.insert(0, ISLAND + "/工具")
src_ct = importlib.import_module("ceres_transfer")
src_ts = importlib.import_module("s4_target_scan")
src_pi = importlib.import_module("s4_polar_illum")

from mission_sim.analysis.interplanetary import two_body as tb
from mission_sim.analysis.interplanetary import target_scan as ts
from mission_sim.analysis import polar_illumination as pi

fail = []
def eq(name, a, b):
    if isinstance(a, float) or isinstance(b, float):
        ok = (a == b)
    else:
        ok = (a == b)
    if not ok: fail.append((name, a, b))

# 1) 常数
for n in ["AU_KM", "MU_SUN", "JD_J2000", "SEC_PER_DAY", "DEG", "LAMBERT_TOL",
          "SIN_DEGEN", "Z_MAX_FRAC", "KEPLER_TOL"]:
    eq("const." + n, getattr(tb, n), getattr(src_ct, n))
eq("EARTH specs", tb.EARTH_J2000, src_ct.EARTH)
eq("TARGETS", ts.TARGETS, src_ts.TARGETS)
eq("DEFAULT_ORDER", ts.DEFAULT_ORDER, src_ts.DEFAULT_ORDER)
eq("SBDB_SNAPSHOT_EPOCH", ts.SBDB_SNAPSHOT_EPOCH, src_ts.SBDB_SNAPSHOT_EPOCH)

# 2) 星历状态（逐位）
e_src, c_src = src_ct.Ephemeris(src_ct.EARTH), src_ct.Ephemeris(src_ct.CERES_SNAPSHOT)
e_my, c_my = tb.Ephemeris(tb.EARTH_J2000), tb.Ephemeris(ts.spec_of("ceres"))
for jd in [2451545.0, 2461200.5, 2462502.5, 2466477.5, 2468307.5]:
    eq(f"earth.state({jd})", e_my.state(jd), e_src.state(jd))
    eq(f"ceres.state({jd})", c_my.state(jd), c_src.state(jd))

# 3) Lambert / 腿 / Hohmann（逐位）
for (r1, r2, tof) in [((1.0*1.495978707e8, 0.0, 0.0), (3.0*1.495978707e8, 4.0*1.495978707e8, 0.0), 3.0e7),
                      ((1.495978707e8, 0.0, 0.0), (-4.1e8, 1e5, 3e7), 5.0e7)]:
    eq("lambert", tb.lambert(r1, r2, tof), src_ct.lambert(r1, r2, tof))
    eq("lambert_retro", tb.lambert(r1, r2, tof, prograde=False),
       src_ct.lambert(r1, r2, tof, prograde=False))
for key in ts.DEFAULT_ORDER:
    spec = ts.spec_of(key)
    a = spec["a_au"]
    eq(f"hohmann({key})", tb.hohmann_transfer(1.0, a), src_ct._hohmann_analytic(1.0, a))
    eq(f"lambert_on_180({key})", tb.lambert_on_180(1.0, a, 4.0e7, 0.0),
       src_ct._lambert_on_180(1.0, a, 4.0e7, 0.0))
for key in ts.DEFAULT_ORDER:
    lj, tof = 2464000.5, 700.0
    eq(f"direct_leg({key})", tb.direct_leg(lj, tof, e_my, tb.Ephemeris(ts.spec_of(key))),
       src_ct.direct_leg(lj, tof, e_src, src_ct.Ephemeris(src_ts.spec_of(key))))
eq("tof_grid", tb.tof_grid(600, 1600, 10), src_ct._tof_list(600, 1600, 10))

# 4) 极区光照核（逐位）
eq("EPS/ROT_H/S0", (pi.EPS, pi.ROT_H, pi.SOL_CONST_WM2),
   (src_pi.EPS, src_pi.ROT_H, src_pi.SOL_CONST_WM2))
for phi in [0.0, 60.0, 84.0, 85.0, 89.0, 90.0]:
    for th in src_pi.THS:
        eq(f"annual_frac({phi},{th})", pi.annual_frac(phi, th), src_pi.annual_frac(phi, th))
        eq(f"annual_insol({phi},{th})", pi.annual_insolation(phi, th), src_pi.annual_insolation(phi, th))
    eq(f"peak_elev({phi})", pi.peak_elev(phi), src_pi.peak_elev(phi))
    eq(f"psr({phi})", pi.psr_dD_threshold(phi), src_pi.psr_dD_threshold(phi))
for phi, dl in [(83.3247, 2.67), (84.31, 2.27), (81.856, 3.05)]:
    eq(f"winter_day({phi})", pi.winter_day_length_h(phi), src_pi.winter_day_length_h(phi))
for d in [-4.028, -2.0, 0.0, 3.0]:
    eq(f"diurnal(85,{d},0)", pi.diurnal_frac(85.0, d, 0.0), src_pi._diurnal_frac(85.0, d, 0.0))
eq("delta_pdf_quad", pi.delta_pdf_quad(), src_pi._delta_pdf_quad())
eq("c1b_lat_limit", pi.c1b_lat_limit(2.0), src_pi._c1b_lat_limit(2.0))

print("对比项总数：常数/状态/求解器/判据 逐位比对")
print("MISMATCHES =", len(fail))
for f in fail[:10]:
    print("  ", f)
print("RESULT:", "ALL BIT-IDENTICAL" if not fail else "DIFF FOUND")

