"""对拍：MCPC target_scan 全网格结果 vs 岛内参考 JSON（逐位比对）。"""
import json
import subprocess
import sys

ISLAND = "/mnt/data/huo/Documents/Kimi/Workspaces/行星探测工程/专题工作区/谷神星探测"
MINE = "/tmp/mcpc_s4_scan.json"

subprocess.run(
    [
        sys.executable, "-m", "mission_sim.analysis.interplanetary.target_scan",
        "--t0", "2030-01-01", "--t1", "2045-12-31", "--step", "15",
        "--tof-min", "600", "--tof-max", "1600", "--tof-step", "10",
        "--top-per-year", "3", "--txt", "/tmp/mcpc_s4_scan.txt", "--json", MINE,
    ],
    check=True,
)

ref = json.load(open(f"{ISLAND}/任务/S4_仿真线_目标扫描.json"))
ref_baseline = json.load(open(f"{ISLAND}/任务/ceres_transfer_direct_wide.json"))
mine = json.load(open(MINE))


def walk(a, b, path, out):
    if isinstance(a, dict):
        assert set(a) == set(b), (path, set(a) ^ set(b))
        for k in a:
            walk(a[k], b[k], f"{path}.{k}", out)
    elif isinstance(a, list):
        assert len(a) == len(b), (path, len(a), len(b))
        for i, (x, y) in enumerate(zip(a, b)):
            walk(x, y, f"{path}[{i}]", out)
    elif isinstance(a, float) or isinstance(b, float):
        if not a == b:
            out.append((path, a, b, a - b))
    else:
        if a != b:
            out.append((path, a, b, None))


mismatch = []
n_fields = 0
for key in ref["targets"]:
    r, m = ref["targets"][key], mine["targets"][key]
    for sub in ("global_best", "hohmann_lower_bound", "per_year_top"):
        walk(r[sub], m[sub], f"{key}.{sub}", mismatch)
    assert r["grid_points"] == m["grid_points"] == 39390, key
    n_fields += 1

mismatch_baseline = []
walk(
    ref_baseline["global_best"],
    mine["targets"]["ceres"]["global_best"],
    "ceres_baseline.global_best",
    mismatch_baseline,
)

print("网格点：6 目标均 39390（与岛内一致）")
print("字段组：6 目标 × {global_best, hohmann_lower_bound, per_year_top(16 年×3 条)}")
print("对拍 1：vs 任务/S4_仿真线_目标扫描.json        MISMATCHES =", len(mismatch))
print("对拍 2：vs 任务/ceres_transfer_direct_wide.json MISMATCHES =", len(mismatch_baseline))
print("容差：0（逐位相等，== 比较浮点）")
print("RESULT:", "ALL BIT-IDENTICAL" if not mismatch and not mismatch_baseline else "DIFF FOUND")
for row in (mismatch + mismatch_baseline)[:10]:
    print("  ", row)

